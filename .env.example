# ─────────────────────────────────────────────────────────────
# Bella Vista — environment variables
# Copy to `.env` and fill in real values: `cp .env.example .env`
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bella_vista?schema=public"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used for metadata, canonical URLs, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Demo admin credentials created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@bellavista.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ── Optional integration seams (leave blank in dev) ──
# Transactional email (order confirmations)
RESEND_API_KEY=""
# Payments (checkout is stubbed until configured)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Telegram order notifications (staff alerts on new orders)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
